#!/bin/sh
#
# @name Raynor Quadrotor SITL (Vision)
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Gazebo uses FLU (+Y left), while PX4 control allocation uses FRD (+Y right).
# Keep the SDF motor indices, but mirror their Y coordinates for PX4.
param set-default CA_ROTOR0_PX 0.056
param set-default CA_ROTOR0_PY 0.056
param set-default CA_ROTOR0_KM 0.0088

param set-default CA_ROTOR1_PX -0.056
param set-default CA_ROTOR1_PY -0.056
param set-default CA_ROTOR1_KM 0.0088

param set-default CA_ROTOR2_PX 0.056
param set-default CA_ROTOR2_PY -0.056
param set-default CA_ROTOR2_KM -0.0088

param set-default CA_ROTOR3_PX -0.056
param set-default CA_ROTOR3_PY 0.056
param set-default CA_ROTOR3_KM -0.0088

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# EKF2: external vision position and velocity, no GPS
param set-default EKF2_EV_DELAY 5
param set-default EKF2_EV_CTRL 15
param set-default EKF2_HGT_REF 0
param set-default EKF2_GPS_CTRL 0
param set-default ATT_EXT_HDG_M 1

# Attitude PID parameters intentionally come from the local PX4 parameter
# store so this airframe does not overwrite the user's tuned values.
param set-default MPC_THR_HOVER 0.3
param set-default MPC_THR_MIN 0.12
param set-default MPC_XY_P 2.2
param set-default MPC_XY_VEL_P_ACC 4.0
param set-default MPC_Z_P 0.8
param set-default MPC_Z_VEL_P_ACC 4.0
param set-default MPC_TILTMAX_AIR 45
param set-default MPC_TILTMAX_LND 12
