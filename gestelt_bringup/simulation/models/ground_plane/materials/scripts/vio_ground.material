material VIO/HighContrastGround
{
  technique
  {
    pass
    {
      ambient 0.8 0.8 0.8 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.05 0.05 0.05 1.0 2.0

      texture_unit
      {
        texture vio_ground.png
        filtering anisotropic
        max_anisotropy 16
        scale 0.025 0.025
      }
    }
  }
}
