<?xml version="1.0"?>
<sdf version="1.7">
  <world name="rmuc2025">
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="rmuc2025_ground">
      <static>true</static>
      <pose>3 -12 -0.01 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15.036 28.036</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15.036 28.036</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.62 0.64 0.62 1</ambient>
            <diffuse>0.72 0.74 0.70 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://rmuc2025_field</uri>
      <name>rmuc2025_field</name>
      <pose>3 -12 0 0 0 0</pose>
      <static>true</static>
    </include>

    <scene>
      <ambient>0.55 0.58 0.60 1</ambient>
      <background>0.78 0.84 0.90 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <physics default="1" type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.2</cfm>
          <erp>0.8</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
