 PARAM_DEFINE_FLOAT(COM_VEL_FS_EVH, 1.f);
 
+/**
+ * Accept fresh external vision velocity for local navigation validity.
+ *
+ * When enabled, a recently fused external vision velocity measurement keeps
+ * local position and velocity valid even if the integrated horizontal position
+ * uncertainty exceeds COM_POS_FS_EPH. It also prevents local velocity from
+ * becoming invalid during a VIO-to-AI source handoff while external velocity
+ * is still being fused. EKF validity bits, data timestamps, finite velocity,
+ * and the 250 ms fusion freshness check are still enforced.
+ * Disable this for configurations where external velocity must not support
+ * local position-control modes.
+ *
+ * @boolean
+ * @value 0 Disabled
+ * @value 1 Enabled
+ * @group Commander
+ */
+PARAM_DEFINE_INT32(COM_POS_FS_EVV, 0);
+
+/**
+ * Hold local position and velocity valid after the first valid armed state.
+ *
+ * Controlled test mode only. This prevents VIO loss, growing covariance and
+ * inertial dead-reckoning timeouts from clearing the horizontal local
+ * position and velocity validity flags. The estimator continues inertial
+ * propagation and its estimate can drift.
+ *
+ * The same implementation applies to SITL, HIL, bench hardware and tethered
+ * flight tests. Do not use it as a production navigation or safety function.
+ *
+ * @boolean
+ * @value 0 Disabled
+ * @value 1 Enabled
+ * @group Commander
+ */
+PARAM_DEFINE_INT32(COM_POS_FS_HOLD, 0);
+
 /**
  * Next flight UUID
