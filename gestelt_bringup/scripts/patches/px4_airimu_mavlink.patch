+/**
+ * Enable AirIMU IMU correction input.
+ *
+ * Apply bounded acceleration and angular-rate offsets received from the
+ * MAVLink airimu_correction topic to the EKF2 IMU increments. If corrections
+ * are invalid or stale, EKF2 continues using the uncorrected IMU.
+ *
+ * @group EKF2
+ * @boolean
+ */
+PARAM_DEFINE_INT32(EKF2_AIRIMU_EN, 0);
+
+/**
+ * AirIMU correction timeout.
+ *
+ * Maximum age of an AirIMU correction before EKF2 falls back to the
+ * uncorrected IMU.
+ *
+ * @group EKF2
