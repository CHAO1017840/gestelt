index e0697f787a..fde901631b 100644
--- a/src/modules/mavlink/mavlink_receiver.cpp
+++ b/src/modules/mavlink/mavlink_receiver.cpp
@@ -354,6 +354,9 @@ MavlinkReceiver::handle_message(mavlink_message_t *msg)
 		default:
 			break;
 		}
+
+	} else if (_mavlink->get_airimu_enabled() && msg->msgid == MAVLINK_MSG_ID_HIL_SENSOR) {
+		handle_message_airimu_correction(msg);
 	}
 
 
@@ -2231,6 +2234,37 @@ MavlinkReceiver::get_message_interval(int msgId)
 	mavlink_msg_message_interval_send(_mavlink->get_channel(), msgId, interval);
 }
 
+void
+MavlinkReceiver::handle_message_airimu_correction(mavlink_message_t *msg)
+{
+	mavlink_hil_sensor_t correction;
+	mavlink_msg_hil_sensor_decode(msg, &correction);
+
+	constexpr uint32_t required_fields{0b111111};
+
+	if ((correction.fields_updated & required_fields) != required_fields) {
+		return;
+	}
+
+	const hrt_abstime now = hrt_absolute_time();
+	const hrt_abstime message_time = correction.time_usec;
+
+	airimu_correction_s report{};
+	report.timestamp = now;
+	report.timestamp_sample =
+		(message_time > 0 && message_time <= now + 1_s && message_time + 1_s >= now) ? message_time : now;
+	report.sequence = msg->seq;
+	report.acceleration_offset[0] = correction.xacc;
+	report.acceleration_offset[1] = correction.yacc;
+	report.acceleration_offset[2] = correction.zacc;
+	report.angular_velocity_offset[0] = correction.xgyro;
+	report.angular_velocity_offset[1] = correction.ygyro;
+	report.angular_velocity_offset[2] = correction.zgyro;
+	report.valid = true;
+
+	_airimu_correction_pub.publish(report);
+}
