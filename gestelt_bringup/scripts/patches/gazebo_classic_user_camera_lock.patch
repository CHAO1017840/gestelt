+/////////////////////////////////////////////////
+void UserCameraPlugin::ParseLockedModels()
+{
+  const char *lockedModels = std::getenv("PX4_GUI_LOCK_MODELS");
+  if (!lockedModels)
+    return;
+
+  std::stringstream stream(lockedModels);
+  std::string entry;
+  while (std::getline(stream, entry, ','))
+  {
+    entry = Trim(entry);
+    if (entry.empty())
+      continue;
+
+    while (!entry.empty() &&
+           (entry.front() == '/' || entry.front() == '\\'))
+      entry.erase(entry.begin());
+    if (!entry.empty())
+      this->locked_models_.push_back(entry);
+  }
+
+  if (!this->locked_models_.empty())
+  {
+    gzmsg << "[UserCameraPlugin] GUI models are read-only:";
+    for (const auto &lockedModel : this->locked_models_)
+      gzmsg << " " << lockedModel;
+    gzmsg << std::endl;
+  }
+}
+
+/////////////////////////////////////////////////
+void UserCameraPlugin::EnsureGlWidget()
+{
+  if (this->gl_widget_ || this->locked_models_.empty())
+    return;
+
+  gui::MainWindow *mainWindow = gui::get_main_window();
+  if (!mainWindow)
+    return;
+
+  this->gl_widget_ = mainWindow->findChild<gui::GLWidget *>();
+  if (this->gl_widget_)
+  {
+    this->gl_widget_->installEventFilter(this);
+    gzmsg << "[UserCameraPlugin] Mouse editing lock installed for "
+          << this->locked_models_.size() << " model(s)" << std::endl;
+  }
+}
+
+/////////////////////////////////////////////////
+bool UserCameraPlugin::IsLockedName(const std::string &_name) const
+{
+  std::string name = _name;
+  const std::string world = gui::get_world();
+  if (!world.empty() && name.compare(0, world.size() + 2, world + "::") == 0)
+    name.erase(0, world.size() + 2);
+  while (!name.empty() && (name.front() == '/' || name.front() == '\\'))
+    name.erase(name.begin());
+
+  for (const auto &lockedModel : this->locked_models_)
+  {
+    if (name == lockedModel)
+      return true;
+    if (name.compare(0, lockedModel.size() + 2, lockedModel + "::") == 0)
+      return true;
+  }
+  return false;
+}
+
+/////////////////////////////////////////////////
+bool UserCameraPlugin::IsLockedVisual(
+    const rendering::VisualPtr &_visual) const
+{
+  if (!_visual)
+    return false;
+
+  const rendering::VisualPtr root = _visual->GetRootVisual();
+  return this->IsLockedName(_visual->Name()) ||
+         (root && this->IsLockedName(root->Name()));
+}
+
+/////////////////////////////////////////////////
+bool UserCameraPlugin::IsLockedAtPosition(
+    const ignition::math::Vector2i &_position) const
+{
+  const rendering::UserCameraPtr camera = gui::get_active_camera();
+  return camera && this->IsLockedVisual(camera->Visual(_position));
+}
+
+/////////////////////////////////////////////////
+bool UserCameraPlugin::eventFilter(QObject *_watched, QEvent *_event)
+{
+  if (!this->gl_widget_ || _watched != this->gl_widget_.data())
+    return GUIPlugin::eventFilter(_watched, _event);
+
+  if (_event->type() == QEvent::MouseButtonPress)
+  {
+    const auto *mouseEvent = static_cast<QMouseEvent *>(_event);
+    const ignition::math::Vector2i position(mouseEvent->pos().x(),
+                                             mouseEvent->pos().y());
+    this->locked_mouse_press_ = this->IsLockedAtPosition(position);
+    this->locked_mouse_dragged_ = false;
+    this->press_x_ = position.X();
+    this->press_y_ = position.Y();
+  }
+  else if (_event->type() == QEvent::MouseMove && this->locked_mouse_press_)
+  {
+    const auto *mouseEvent = static_cast<QMouseEvent *>(_event);
+    if (mouseEvent->buttons() != Qt::NoButton &&
+        (mouseEvent->pos().x() != this->press_x_ ||
+         mouseEvent->pos().y() != this->press_y_))
+    {
+      this->locked_mouse_dragged_ = true;
+    }
+  }
+  else if (_event->type() == QEvent::MouseButtonRelease &&
+           this->locked_mouse_press_)
+  {
+    const bool blockSelection =
+        !this->locked_mouse_dragged_ &&
+        this->IsLockedAtPosition(
+            ignition::math::Vector2i(this->press_x_, this->press_y_));
+    this->locked_mouse_press_ = false;
+    this->locked_mouse_dragged_ = false;
+
+    if (blockSelection)
+    {
+      const auto *mouseEvent = static_cast<QMouseEvent *>(_event);
+      this->ForwardReleaseToCamera(mouseEvent);
+      gzmsg << "[UserCameraPlugin] Ignored read-only model click"
+            << std::endl;
+      return true;
+    }
+  }
+
+  return GUIPlugin::eventFilter(_watched, _event);
+}
+
+/////////////////////////////////////////////////
+void UserCameraPlugin::ForwardReleaseToCamera(const QMouseEvent *_event)
+{
+  const rendering::UserCameraPtr camera = gui::get_active_camera();
+  if (!camera)
+    return;
+
+  common::MouseEvent mouseEvent;
+  mouseEvent.SetPos(_event->pos().x(), _event->pos().y());
+  mouseEvent.SetPrevPos(_event->pos().x(), _event->pos().y());
+  mouseEvent.SetPressPos(this->press_x_, this->press_y_);
+  mouseEvent.SetButton(ToMouseButton(_event->button()));
+  mouseEvent.SetButtons(common::MouseEvent::NO_BUTTON);
+  mouseEvent.SetType(common::MouseEvent::RELEASE);
+  mouseEvent.SetDragging(false);
+  mouseEvent.SetShift((_event->modifiers() & Qt::ShiftModifier) != 0);
+  mouseEvent.SetControl((_event->modifiers() & Qt::ControlModifier) != 0);
+  mouseEvent.SetAlt((_event->modifiers() & Qt::AltModifier) != 0);
+  camera->HandleMouseEvent(mouseEvent);
+}
+
+/////////////////////////////////////////////////
+void UserCameraPlugin::OnSelectedEntity(const std::string &_name,
+                                        const std::string & /*_mode*/)
+{
+  if (!this->IsLockedName(_name))
+    return;
+
+  QTimer::singleShot(0, this, [this]()
+  {
+    this->ClearLockedSelection();
+  });
+}
+
+/////////////////////////////////////////////////
+void UserCameraPlugin::ClearLockedSelection()
+{
+  if (!this->gl_widget_)
+    return;
+
+  this->gl_widget_->setFocus(Qt::OtherFocusReason);
+  QKeyEvent escapeEvent(QEvent::KeyPress, Qt::Key_Escape, Qt::NoModifier);
+  QApplication::sendEvent(this->gl_widget_, &escapeEvent);
+}
